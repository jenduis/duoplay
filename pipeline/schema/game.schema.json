{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duoplay.vercel.app/schema/game.schema.json",
  "title": "DuoPlay Game",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "platforms", "coop", "versus", "maxPlayers", "genres",
    "releaseDate", "publisher", "ids", "cover", "curatorPick", "editorial", "sources", "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["switch", "switch2", "3ds", "ds"] }
    },
    "coop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign", "local", "localWireless", "online", "downloadPlay", "gameShare", "dropInOut"],
      "properties": {
        "campaign": { "type": "boolean" },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max", "sameScreen", "splitScreen"],
          "properties": {
            "max": { "$ref": "#/$defs/playerCount" },
            "sameScreen": { "type": "boolean" },
            "splitScreen": { "type": "boolean" }
          }
        },
        "localWireless": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max"],
          "properties": { "max": { "$ref": "#/$defs/playerCount" } }
        },
        "online": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max"],
          "properties": { "max": { "$ref": "#/$defs/playerCount" } }
        },
        "downloadPlay": { "type": "boolean" },
        "gameShare": { "type": "boolean" },
        "dropInOut": { "type": ["boolean", "null"] }
      }
    },
    "versus": { "type": "boolean" },
    "maxPlayers": { "$ref": "#/$defs/playerCount" },
    "genres": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "releaseDate": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
    },
    "publisher": { "type": ["string", "null"] },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "switchTitleId": { "type": "string", "pattern": "^[0-9A-F]{16}$" },
        "nsuId": { "type": "string" },
        "ctrProductCode": { "type": "string" },
        "cooptimusUrl": { "type": "string", "format": "uri" }
      }
    },
    "cover": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "source"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "source": { "enum": ["titledb", "nlib", "gametdb", "manual"] }
          }
        }
      ]
    },
    "curatorPick": { "type": "boolean" },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "coopSummary", "setupGuide", "vibe", "difficulty", "audiences", "aiGenerated", "reviewed"],
      "properties": {
        "summary": { "type": "string" },
        "coopSummary": { "type": "string" },
        "setupGuide": { "type": "string" },
        "vibe": { "enum": ["Cozy", "Story", "Chaos", "Puzzle", "Action", "Competitive"] },
        "difficulty": { "enum": ["Very Chill", "Low", "Medium", "Hard"] },
        "audiences": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["couples", "friends", "kids", "family", "party"] }
        },
        "aiGenerated": { "type": "boolean" },
        "reviewed": { "type": "boolean" }
      }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "updatedAt": { "type": "string" }
  },
  "$defs": {
    "playerCount": { "type": ["integer", "null"], "minimum": 1, "maximum": 64 }
  }
}
